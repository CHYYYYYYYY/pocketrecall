# Copy to .env.local. Keep your real key out of git and the browser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Duplex voice + video, uses the same server-only Gemini key
GEMINI_LIVE_MODEL=gemini-3.8-live
PORT=3000

# Optional: real video 3D reconstruction via fal-ai/vggt-1b (server-only)
FAL_KEY=
